# Copy to .env and fill in. Never commit .env.

# Deployer private key. The deploy driver reads DEPLOYER_PRIVATE_KEY first, then
# falls back to the project wallet at D:\Genlayer-project\wallet\.env, reading its
# GENLAYER_DEV_KEY. Override the wallet location with SACRAMENTUM_KEY_FILE.
DEPLOYER_PRIVATE_KEY=

# Seller key for the end-to-end demo. Falls back to the wallet's recipient.json.
SACRAMENTUM_SELLER_KEY=
